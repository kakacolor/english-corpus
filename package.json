{
  "name": "english-corpus-vocab",
  "version": "1.0.0",
  "description": "英语语料积累软件 - 拍照识词/单词本/艾宾浩斯背单词/多端同步",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "sync:app-env": "node scripts/make-app-env.js",
    "build:apk": "node scripts/make-app-env.js && cd app && eas build -p android --profile preview --non-interactive"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.4",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "mysql2": "^3.9.7",
    "xlsx": "^0.18.5"
  }
}
