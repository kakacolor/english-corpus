# ============================================================================
#  英语语料积累 — 全局配置模板
#  复制为 .env 后按实际情况填写： cp .env.example .env
#
#  后端、前端（Web/手机 App）、部署脚本与 docker-compose 都从根目录这一个
#  .env 读取配置。迁移到别的服务器时通常只需改本文件。
#  改完前端相关项后需清缓存重建前端：在 app/ 目录执行  npm run build:web
# ============================================================================

# ===== 一、本服务器地址（迁移主要改这一段）=====
# 服务器 IP 或域名
SERVER_HOST=192.168.1.100
# 后端监听/对外端口
SERVER_PORT=3000
# http 或 https
SERVER_SCHEME=http
# 前端要访问的后端地址；留空 = 自动用上面三项拼成 <协议>://<主机>:<端口>
EXPO_PUBLIC_API_URL=

# ===== 二、部署路径与运行身份（deploy/install-service.sh 读取）=====
# 项目在服务器上的绝对路径
APP_DIR=/opt/english-corpus
# systemd 服务名
SERVICE_NAME=english-corpus
# 运行后端的系统用户
RUN_USER=root
# node 绝对路径；留空 = 自动探测
NODE_BIN=

# ===== 三、数据库 =====
# 数据库地址与端口（与后端同机用 127.0.0.1）
DB_HOST=127.0.0.1
DB_PORT=3306
# 库名与专用账号（db/setup-db.sh 与 docker-compose 共用）
DB_NAME=english_corpus
DB_USER=english_user
DB_PASSWORD=change-me-strong-password
# MySQL root 密码：建库建账号 / docker-compose 起库时需要
DB_ROOT_PASSWORD=
# 数据库若是 Docker 容器，填容器名（可留空）
DB_CONTAINER_NAME=

# ===== 四、密钥 =====
# JWT 密钥（生产环境务必改成随机长字符串，可用 node -e "console.log(require('crypto').randomBytes(64).toString('hex'))" 生成）
# 注意：改动后所有已登录用户都需要重新登录。
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# AI 密钥加密密钥（AES-256-GCM，64 位十六进制）
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 注意：改动后老用户已保存的 AI API Key 将无法解密，需要重新配置。
AI_KEY_ENC_SECRET=please-change-me-to-a-64-hex-random-string

# ===== 五、其他运行参数 =====
NODE_ENV=production
# 单个上传文件上限（MB）
MAX_UPLOAD_MB=10
# 拍照识别限流：每小时每账号允许次数
AI_RECOGNIZE_RATE_LIMIT=50
# none 关闭请求日志；默认开启
LOG_LEVEL=info

# ===== 六、（可选）从旧服务器拉取迁移包时使用 =====
# 仅 deploy/migrate-from-server.sh 会读这一段；平时留空即可。
OLD_SERVER_HOST=
OLD_SERVER_USER=root
OLD_SERVER_PASS=
OLD_SERVER_SSH_PORT=22
# SSH 主机密钥指纹（PuTTY 的 plink/pscp 用；留空则走 known_hosts）
OLD_SERVER_HOSTKEY=
# 旧服务器上的项目目录与数据库容器（用于 mysqldump）
OLD_SERVER_APP_DIR=/opt/english-corpus
OLD_SERVER_DB_CONTAINER=
OLD_SERVER_DB_ROOT_PASSWORD=
